// keyboard.zaman - محاكاة لوحة المفاتيح
// في نواة حقيقية، نقرأ من منفذ 0x60
// هنا: نحاكي بأوامر من المستخدم

// في نواة حقيقية: حلقة تنتظر ضغطة مفتاح
// هنا: نختبر بأوامر ثابتة

fn كيبورد_اختبار() {
    print("اختبار لوحة المفاتيح:")
    print("  زر A تم ضغطه")
    print("  زر Enter تم ضغطه")
    print("  زر Space تم ضغطه")
}
