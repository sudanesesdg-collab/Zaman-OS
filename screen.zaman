// screen.zaman - محاكاة شاشة VGA للنواة
// في نواة حقيقية، هذه كتابة مباشرة إلى الذاكرة 0xB8000
// هنا، نحاكيها بقائمة نصوص

var screen_lines = []
var current_line = 0

// نطبع سطرًا على الشاشة
fn شاشة_طباعة(نص) {
    // في نواة حقيقية: كتابة مباشرة في الذاكرة
    // هنا: نحاكي بطباعة عادية
    print(نص)
}

// نمسح الشاشة
fn شاشة_مسح() {
    print("=== شاشة زمان ===")
}

// نطبع خطًا فاصلًا
fn شاشة_خط() {
    print("----------------")
}
