import "commands.zaman"

fn main() {
    print("Zaman OS Terminal v0.2")
    print("اكتب help")
    var running = 1
    while running == 1 {
        print("zaman>")
        let cmd = input()
        if cmd == "exit" {
            print("مع السلامة")
            running = 0
        } else if cmd == "help" {
            help_cmd()
        } else if cmd == "time" {
            time_cmd()
        } else if cmd == "info" {
            info_cmd()
        } else {
            print("غير معروف:", cmd)
        }
    }
}

main()
