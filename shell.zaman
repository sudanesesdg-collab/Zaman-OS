import "commands.zaman"
fn main() {
    print("Zaman OS v0.2")
    var running = 1
    while running == 1 {
        print("zaman>")
        let cmd = input()
        if cmd == "exit" {
            running = 0
        }
        if cmd == "help" {
            help_cmd()
        }
        if cmd == "time" {
            time_cmd()
        }
        if cmd == "info" {
            info_cmd()
        }
        if cmd == "clear" {
            clear_cmd()
        }
    }
}
main()
