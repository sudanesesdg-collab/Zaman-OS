import "screen.zaman"
import "keyboard.zaman"

// =============================
//     نواة زمان - Zaman OS
// =============================

fn kernel_init() {
    شاشة_مسح()
    شاشة_طباعة("================================")
    شاشة_طباعة("   Zaman OS Kernel v0.1")
    شاشة_طباعة("   نظام زمان - النواة الأولى")
    شاشة_طباعة("================================")
    شاشة_طباعة("")
    شاشة_طباعة("[OK] تحميل النواة")
    شاشة_طباعة("[OK] تهيئة الشاشة")
    شاشة_طباعة("[OK] تهيئة لوحة المفاتيح")
    شاشة_طباعة("[OK] تهيئة الذاكرة")
    شاشة_طباعة("")
    شاشة_طباعة("مرحبا بك في زمان OS!")
    شاشة_طباعة("")
}

fn kernel_panic(رسالة) {
    شاشة_خط()
    شاشة_طباعة("!!! خطأ فادح في النواة !!!")
    شاشة_طباعة(رسالة)
    شاشة_خط()
}

fn kernel_main() {
    kernel_init()
    
    // اختبار لوحة المفاتيح
    print("")
    كيبورد_اختبار()
    
    // اختبار دالة panic
    print("")
    شاشة_طباعة("اختبار النواة اكتمل بنجاح ✓")
    شاشة_طباعة("النواة جاهزة للعمل!")
}

kernel_main()
